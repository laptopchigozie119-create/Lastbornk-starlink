# Client-safe Supabase settings (Vite exposes VITE_* to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:4000

# Server-only secrets — never prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
APP_URL=http://localhost:5173
PORT=4000

# Testing mode: simulate successful MikroTik activation and issue a 6-digit PIN.
# Set to false only after the physical router provisioning adapter is connected.
MOCK_ROUTER_ENABLED=true
# Safety lock. Keep false during simulation. Physical mode requires this=true
# AND MOCK_ROUTER_ENABLED=false.
PHYSICAL_ROUTER_LIVE=false
# Required only when enabling controller-webhook hardware credentials:
# openssl rand -base64 32
ROUTER_CREDENTIALS_KEY=
# Shared with FreeRADIUS/controller calls to /api/network/authorize.
NETWORK_SHARED_SECRET=replace-with-a-different-long-random-value

# Local UI development only. Never enable in production.
DEV_BYPASS_AUTH=true
# Use a real auth.users UUID created in your Supabase project.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Admin API calls additionally require this header. Rotate regularly.
ADMIN_API_KEY=replace-with-a-long-random-value
